# Backend
# Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_simulator
# Production (Render internal URL — use the Internal Database URL from Render dashboard,
# NOT the External Database URL; internal keeps traffic within Render's private network):
# DATABASE_URL=postgresql://<user>:<password>@<internal-host>/<dbname>
ENVIRONMENT=development
# Set to "production" on Render

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production: set to your Render backend service URL, e.g. https://your-api.onrender.com
